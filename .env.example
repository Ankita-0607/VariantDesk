# ---- Database ----
DATABASE_URL=postgresql://variantdesk:variantdesk@localhost:5432/variantdesk

# ---- Auth ----
# Change this! Used to sign session tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Seed users (phase 1 has no user-management UI). Format: email:role:password, comma-separated.
# Roles: ADMIN, ANALYST, LAB_DIRECTOR
SEED_USERS=admin@lab.local:ADMIN:admin123,analyst@lab.local:ANALYST:analyst123,director@lab.local:LAB_DIRECTOR:director123

# ---- AI ----
# Provider: anthropic | openai_compatible | none
AI_PROVIDER=none
# Anthropic (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# OpenAI-compatible local server, e.g. Ollama: http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=llama3.1
OPENAI_COMPATIBLE_API_KEY=

# ---- Knowledge sources ----
# Optional NCBI API key raises E-utilities rate limit from 3 to 10 req/s.
NCBI_API_KEY=
# Cache TTL for external lookups (hours)
KB_CACHE_TTL_HOURS=168
# Set to 1 to never call external APIs (uses cache only) — useful for air-gapped labs.
KB_OFFLINE=0
# Max variants sent for annotation per case (Ensembl REST is meant for panels, not WGS)
MAX_VARIANTS_PER_CASE=2000

# ---- Web ----
PORT=3000
CORS_ORIGIN=http://localhost:5173
